a = float(input("Ingrese el primer número: "))
b = float(input("Ingrese el segundo número: "))
print("suma: {:.3f}".format(a + b))
print("Resta: {:.3f}".format(a - b))
print("Multiplicacion: {:.3f}".format(a * b))
print("división: {:.3f}".format(a // b))
print("Division: {:.3f}".format(a / b))
print("Modulo: {:.3f}".format(a % b))
print("potenciacion: {:.3f}".format(a ** b))
